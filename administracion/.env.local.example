# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la pongas en el navegador ni la compartas.
SUPABASE_SECRET_KEY=

# Claude — para cargar contratos en PDF y que se completen solos.
# HOY ESTÁ APAGADO A PROPÓSITO: dejala vacía y la carga de contratos es
# manual. Cuando quieras encenderla, cargá la clave de console.anthropic.com
# y el recuadro aparece solo en la pantalla de nuevo contrato.
ANTHROPIC_API_KEY=
# Modelo a usar cuando esté encendida. El más barato alcanza para esto.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Clave del proceso que baja los índices todas las noches. Inventá una tira
# larga y al azar; la misma va cargada como secret CRON_SECRET en GitHub.
# Si la dejás vacía, la descarga automática queda apagada y solo funciona el
# botón de la pantalla de Índices.
CRON_SECRET=

# Modo mantenimiento (opcional)
MAINTENANCE_MODE=false
MAINTENANCE_ALLOW_EMAILS=
