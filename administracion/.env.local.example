# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la pongas en el navegador ni la compartas.
SUPABASE_SECRET_KEY=

# Claude — para cargar contratos en PDF y que se completen solos.
# Se saca de console.anthropic.com. Sin esta clave, la carga es manual.
ANTHROPIC_API_KEY=

# Modo mantenimiento (opcional)
MAINTENANCE_MODE=false
MAINTENANCE_ALLOW_EMAILS=
