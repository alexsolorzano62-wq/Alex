NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo servidor: NUNCA con prefijo NEXT_PUBLIC_, nunca se expone al navegador.
# Es la "Secret key" de Supabase (API Keys → Secret keys). Se usa solo para el
# panel de administración de agentes (/admin/agents).
SUPABASE_SECRET_KEY=tu-secret-key

# Modo mantenimiento (opcional). Con "true" los agentes no pueden usar la app:
# ven la pantalla de /mantenimiento. Para reactivarla, poné "false" o borrá la
# variable, y volvé a desplegar.
MAINTENANCE_MODE=false
# Emails que sí pueden entrar durante la pausa (separados por coma).
MAINTENANCE_ALLOW_EMAILS=
